# RVITM Mitra AI - Environment Configuration Example
# Copy this file to .env and adjust variables as required

ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ADMIN_API_KEY=admin-rvitm-demo-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL with pgvector:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rvitm_mitra
# For local offline zero-dependency mode:
# DATABASE_URL=sqlite+aiosqlite:///./rvitm_mitra.db

# AI Provider Selection (options: mock | gemini | openai | anthropic | ollama)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# External API Keys (optional if using mock or ollama)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Models
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# RAG & Retrieval Tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=25
FUSED_TOP_K=6
SIMILARITY_THRESHOLD=0.55
RRF_K=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
